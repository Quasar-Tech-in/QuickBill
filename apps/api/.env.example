# QuickBill API Environment Variables Template
# Copy this file to .env and configure your variables

APP_ENV=development
DEBUG=True
PROJECT_NAME="QuickBill & Inventory API"
VERSION=1.0.0

# MongoDB Database Connection
# Local Docker MongoDB:
MONGODB_URI=mongodb://admin:secretpassword@localhost:27017/quickbill_db?authSource=admin
# Remote / MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickbill_db?retryWrites=true&w=majority
DATABASE_NAME=quickbill_db

# Redis Cache Connection
REDIS_URL=redis://localhost:6379/0

# Security & JWT Secrets
JWT_SECRET=development_jwt_secret_key_32_characters_minimum_quickbill_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# SuperAdmin Initial Credentials (Auto-created on startup if not present)
SUPERADMIN_EMAIL=superadmin@quickbill.local
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_NAME="Super Administrator"


# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081"]
