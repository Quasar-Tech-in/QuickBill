{
  "expo": {
    "name": "QuickBill",
    "slug": "quickbill-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.quickbill.pos",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QuickBill to access your camera to scan item QR codes for billing."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d56d512b-6f1a-45f9-b014-c147aa283f89"
      }
    }
  }
}
